{
  "compilerOptions": {
    "module": "es2022",
    "target": "es2022",
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "noImplicitAny": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
        "@/*": ["./src/*"]
    }
  }
}
